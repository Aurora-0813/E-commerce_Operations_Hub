# ============================================================
# 环境变量模板（复制成 .env 后按需修改）
# ============================================================
#   PowerShell:  Copy-Item backend\.env.example backend\.env
#
# ⚠️ **真实密码绝不能提交进仓库。**
#    这个文件是"模板"，里面只能有占位值；`.env` 已被 .gitignore 忽略。
#
# ⚠️ 生产环境不要用这个文件：
#    应该通过 secrets manager / 环境变量注入（K8s Secret、云厂商的
#    参数管理、Vault 等都行），**不要**把密码写到磁盘上的明文文件里。
#    本地开发用 .env、生产用注入 —— 这是两件不同的事。
# ============================================================

# ---------- 数据库（PostgreSQL）----------
# 格式：postgresql+psycopg://用户名:密码@主机:端口/库名
HUB_STORAGE__URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/E_commerce_Operations

# ---------- 文本模型（OpenAI 兼容协议）----------
# M3 分类/归因、M4 簇名、M5/M6 决策都用它
# **base_url 必须含 /v1** —— 本地是 Ollama 的兼容层；云端填服务商给的 base
# 本地准备：ollama pull qwen2.5:7b
HUB_LLM__BASE_URL=http://localhost:11434/v1
HUB_LLM__MODEL=qwen2.5:7b
HUB_LLM__API_KEY=ollama

# 切到云端：把上面三行换成下面三行（其他不用动）
# HUB_LLM__BASE_URL=https://api.deepseek.com/v1
# HUB_LLM__MODEL=deepseek-chat
# HUB_LLM__API_KEY=sk-你的key

# ---------- 视觉模型（M2 图片打标，必须带视觉能力）----------
# ollama pull qwen2.5vl:3b
HUB_VISION__MODEL=qwen2.5vl:3b

# ---------- Redis（M7 队列）----------
# 格式：redis://:密码@主机:端口/库号（**用户名留空但冒号不能省**）
# 起容器的命令见 docs/开发指南/11_M7调度与队列.md
HUB_QUEUE__URL=redis://:CHANGE_ME@127.0.0.1:6379/0
